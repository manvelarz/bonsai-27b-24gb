FROM docker.io/nvidia/cuda:13.0.0-devel-ubuntu24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git build-essential python3 python3-venv \
    && rm -rf /var/lib/apt/lists/*
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh
WORKDIR /opt/bonsai
COPY install.sh serve.sh ./
RUN bash install.sh
ENV PATH="/opt/bonsai/.venv/bin:$PATH" \
    MODEL_DIR=/models SERVER_HOST=0.0.0.0 \
    XDG_CACHE_HOME=/cache TRITON_CACHE_DIR=/cache/triton VLLM_CACHE_ROOT=/cache/vllm
ENTRYPOINT ["bash", "/opt/bonsai/serve.sh"]
